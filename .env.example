# Placeholder values only. Copy this file to .env and fill in real values locally.
# Never commit .env.

# AI calls are routed through Portkey (required).
PORTKEY_API_KEY=your-portkey-api-key-here

# Only needed for direct OpenAI calls that bypass Portkey (optional).
OPENAI_API_KEY=

# Model for every agent. The assignment requires ONLY gpt-6-luna through Portkey; do not change it.
OPENAI_MODEL=gpt-6-luna

# campus-customs MCP server the agents connect to (start it with: python mcp_server/server.py --http).
MCP_SERVER_URL=http://127.0.0.1:8001/mcp

# Optional Portkey routing overrides (defaults shown).
# PORTKEY_BASE_URL=https://api.portkey.ai/v1
# PORTKEY_PROVIDER=openai
